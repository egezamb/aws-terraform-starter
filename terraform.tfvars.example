aws_region   = "eu-central-1"
project_name = "aws-terraform-starter"
environment  = "dev"

# The VPC takes /16 to /28, and the subnet must lie inside it; the plan fails otherwise.
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

instance_type = "t3.micro"
# Optional: replace with your actual IPv4 CIDR before uncommenting.
# allowed_ssh_cidr = "203.0.113.7/32"

# For SSH, also select an existing key pair in aws_region. Never put a private key here.
# ssh_key_name = "my-lab-key"

# Encrypted gp3 root disk. Increasing this can add storage charges.
root_volume_size_gib = 8
